{% extends "partials/base.html.twig" %}
{% set pageTitle = "My profile" %}

{% block content %}
<div class="max-w-sm mx-auto pt-8">
    <h1 class="text-2xl font-semibold text-gray-900 mb-8 tracking-tight">My profile</h1>

    {% if error is defined %}
        <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-100 text-sm text-red-700">
            {{ error }}
        </div>
    {% endif %}

    <form method="POST" action="/profile" class="space-y-4">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Name</label>
            <input type="text" name="name" value="{{ auth.currentUser.name }}" required
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Email</label>
            <input type="email" name="email" value="{{ auth.currentUser.email }}" required
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>

        <hr class="border-gray-100 my-2">
        <p class="text-xs text-gray-400">Leave password fields blank to keep your current password.</p>

        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">New password <span class="text-gray-400">(min. 8 characters)</span></label>
            <input type="password" name="password" minlength="8"
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Confirm new password</label>
            <input type="password" name="password_confirm"
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>

        <button type="submit"
            class="w-full px-4 py-2.5 text-sm font-medium rounded-xl bg-gray-900 text-white hover:bg-gray-700 transition-colors">
            Save changes
        </button>
    </form>
</div>
{% endblock %}

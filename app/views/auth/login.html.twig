{% extends "partials/base.html.twig" %}
{% set pageTitle = "Login" %}

{% block content %}
<div class="max-w-sm mx-auto pt-16">
    <h1 class="text-2xl font-semibold text-gray-900 mb-8 tracking-tight">Sign in</h1>

    {% if error is defined %}
        <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-100 text-sm text-red-700">
            {{ error }}
        </div>
    {% endif %}

    <form method="POST" action="/login" class="space-y-4">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Email</label>
            <input type="email" name="email" value="{{ email ?? '' }}" required autofocus
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Password</label>
            <input type="password" name="password" required
                class="w-full text-sm border border-gray-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-gray-900">
        </div>
        <button type="submit"
            class="w-full px-4 py-2.5 text-sm font-medium rounded-xl bg-gray-900 text-white hover:bg-gray-700 transition-colors mt-2">
            Sign in
        </button>
    </form>
</div>
{% endblock %}
